{
  "name": "arena-private-merlin-client",
  "main": "client.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8791
  },
  "services": [
    {
      "binding": "MERLIN",
      "service": "buffalo-merlin-private-bridge",
      "entrypoint": "ArenaMerlin",
      "remote": true
    }
  ]
}
